# Local-machine connection strings. docker-compose overrides hosts for its containers.
POSTGRES_DB=fleettrack
POSTGRES_USER=fleettrack
POSTGRES_PASSWORD=change_this_local_password
DATABASE_URL=postgresql://fleettrack:change_this_local_password@localhost:5432/fleettrack
MONGO_INITDB_ROOT_USERNAME=fleettrack
MONGO_INITDB_ROOT_PASSWORD=change_this_mongo_password
MONGODB_URI=mongodb://fleettrack:change_this_mongo_password@localhost:27017/?authSource=admin
MONGODB_DATABASE=fleettrack
APP_ENV=development
SESSION_COOKIE_SECURE=false
FLEETTRACK_SEED=20261119
FLEETTRACK_SEED_ANCHOR=2026-11-19T00:00:00+00:00
